#!/usr/bin/gjs -m
// deepmon-key — управление ключом DeepSeek API и токеном веб-сессии платформы.
// Секрет читается из stdin (без эха в TTY), никогда не попадает в argv и в вывод.
import GLib from 'gi://GLib';
import Gio from 'gi://Gio';
import Secret from 'gi://Secret';
import system from 'system';

const KEY_RE = /^sk-[A-Za-z0-9_-]{16,}$/;
const TOKEN_RE = /^[A-Za-z0-9._-]{16,}$/;
const KEY_TARGET = {
    attributes: {application: 'deepmon', account: 'deepseek-api'},
    label: 'DeepSeek API key',
    fileName: 'key',
    pattern: KEY_RE,
    prompt: 'Вставьте ключ DeepSeek (ввод скрыт): ',
    printed: value => `sk-…${value.slice(-4)}`,
};
const PLATFORM_TARGET = {
    attributes: {application: 'deepmon', account: 'deepseek-platform'},
    label: 'DeepSeek platform session token',
    fileName: 'platform-token',
    pattern: TOKEN_RE,
    prompt: 'Вставьте токен веб-сессии platform.deepseek.com (ввод скрыт): ',
    printed: value => `…${value.slice(-6)}`,
};
const USAGE = `deepmon-key — ключ DeepSeek API и токен платформы

  set [--platform] [--stdin]   сохранить секрет в связке
                               (TTY: ввод без эха; --stdin: из пайпа)
  status                       источники и отпечатки обоих секретов
  fingerprint [--platform]     только отпечаток
  delete [--platform]          удалить секрет из связки
  --help                       эта справка

Без --platform работаем с ключом API (он нужен для баланса).
С --platform — с токеном веб-сессии: он позволяет подтянуть дневные расходы
с platform.deepseek.com (приватный эндпоинт, не ключ API).

Коды возврата: 0 — успех, 2 — неверные аргументы или формат, 3 — ошибка связки.`;

function schema() {
    return Secret.Schema.new('org.freedesktop.Secret.Generic', Secret.SchemaFlags.NONE, {
        application: Secret.SchemaAttributeType.STRING,
        account: Secret.SchemaAttributeType.STRING,
    });
}

function die(message, code) {
    printerr(message);
    system.exit(code);
}

function extensionDir() {
    const candidates = [
        GLib.build_filenamev([GLib.get_user_data_dir(), 'gnome-shell', 'extensions', 'deepmon@fstronin']),
        '/usr/share/gnome-shell/extensions/deepmon@fstronin',
    ];
    const script = Gio.File.new_for_uri(import.meta.url).get_path();
    candidates.push(GLib.build_filenamev([GLib.path_get_dirname(GLib.path_get_dirname(script)), 'src', 'deepmon@fstronin']));
    for (const candidate of candidates) {
        if (Gio.File.new_for_path(GLib.build_filenamev([candidate, 'storage', 'KeyReader.js'])).query_exists(null))
            return candidate;
    }
    die('не найден каталог расширения deepmon', 3);
}

async function storage() {
    const dir = extensionDir();
    const load = name => import(Gio.File.new_for_path(GLib.build_filenamev([dir, 'storage', name])).get_uri());
    const keyReaderModule = await load('KeyReader.js');
    const fileModule = await load('FileKeyReader.js');
    const keyringModule = await load('KeyringKeyReader.js');
    return {
        fingerprint: keyReaderModule.fingerprint,
        KeyReader: keyReaderModule.KeyReader,
        FileKeyReader: fileModule.FileKeyReader,
        KeyringKeyReader: keyringModule.KeyringKeyReader,
    };
}

function stdinIsTty() {
    try {
        const info = Gio.File.new_for_path('/proc/self/fd/0')
            .query_info('unix::mode', Gio.FileQueryInfoFlags.NONE, null);
        return (info.get_attribute_uint32('unix::mode') & 0o170000) === 0o020000;
    } catch (error) {
        return false;
    }
}

function stdinTerminal() {
    try {
        const info = Gio.File.new_for_path('/proc/self/fd/0')
            .query_info('standard::symlink-target', Gio.FileQueryInfoFlags.NONE, null);
        const target = info.get_symlink_target();
        if (!target)
            return null;
        return target.startsWith('/') ? target : `/dev/${target}`;
    } catch (error) {
        return null;
    }
}

// SubprocessLauncher отдаёт ребёнку stdin, а не терминал (ioctl на нём не работает),
// поэтому устройство передаётся явно через -F. Возвращаем успех: без отключения эха
// читать секрет нельзя.
function stty(args) {
    const device = stdinTerminal();
    if (!device)
        return false;
    try {
        const launcher = new Gio.SubprocessLauncher({flags: Gio.SubprocessFlags.NONE});
        launcher.spawnv(['stty', '-F', device, ...args]).wait_check(null);
        return true;
    } catch (error) {
        printerr(`stty ${args.join(' ')}: ${error.message}`);
        return false;
    }
}

function readAll() {
    const [, bytes] = GLib.file_get_contents('/dev/stdin');
    return new TextDecoder().decode(bytes);
}

function readLineWithEchoOff(prompt) {
    const channel = GLib.IOChannel.unix_new(0);
    printerr(prompt);
    if (!stty(['-echo']))
        die('не удалось отключить эхо терминала; используйте --stdin', 3);
    try {
        const [status, line] = channel.read_line();
        return status === GLib.IOStatus.NORMAL ? line : '';
    } finally {
        stty(['echo']);
    }
}

function normalize(text) {
    let value = text.trim();
    if (value.startsWith('Bearer '))
        value = value.slice('Bearer '.length).trim();
    if (value.length >= 2 && ((value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'"))))
        value = value.slice(1, -1).trim();
    return value;
}

function targetFor(args) {
    return args.includes('--platform') ? PLATFORM_TARGET : KEY_TARGET;
}

async function resolveSecret(target) {
    const {KeyReader, FileKeyReader, KeyringKeyReader} = await storage();
    return new KeyReader({
        keyring: new KeyringKeyReader({attributes: target.attributes}),
        file: new FileKeyReader({
            path: GLib.build_filenamev([GLib.get_user_config_dir(), 'deepmon', target.fileName]),
            pattern: target.pattern,
        }),
        keyringTimeoutMs: 4000,
    }).readKey();
}

async function commandSet(args) {
    const target = targetFor(args);
    const useStdin = args.includes('--stdin');
    if (!useStdin && !stdinIsTty())
        die('секрет не передан: используйте --stdin при перенаправлении ввода', 2);

    const raw = useStdin ? readAll() : readLineWithEchoOff(target.prompt);
    const value = normalize(raw);
    if (!target.pattern.test(value))
        die(target === PLATFORM_TARGET
            ? 'неверный токен платформы: ожидается строка от 16 символов'
            : 'неверный формат ключа: ожидается sk-… длиной от 16 символов', 2);

    let stored;
    try {
        stored = Secret.password_store_sync(schema(), target.attributes, Secret.COLLECTION_DEFAULT,
            target.label, value, null);
    } catch (error) {
        die(`не удалось сохранить в связке: ${error.message}`, 3);
    }
    if (!stored)
        die('не удалось сохранить в связке ключей', 3);

    const {fingerprint} = await storage();
    print(`сохранён ${target.printed(value)} · sha256 ${fingerprint(value)}`);
}

async function commandStatus() {
    const {fingerprint} = await storage();
    for (const target of [KEY_TARGET, PLATFORM_TARGET]) {
        const name = target === PLATFORM_TARGET ? 'платформа' : 'ключ API';
        const result = await resolveSecret(target);
        if (!result.ok) {
            print(`${name}: нет (${result.code})`);
            continue;
        }
        const path = result.source === 'file'
            ? GLib.build_filenamev([GLib.get_user_config_dir(), 'deepmon', target.fileName])
            : 'keyring';
        print(`${name}: ${path}, ${target.printed(result.key)} · sha256 ${fingerprint(result.key)}`);
    }
}

async function commandFingerprint(args) {
    const target = targetFor(args);
    const result = await resolveSecret(target);
    if (!result.ok)
        die(`секрета нет (${result.code})`, 3);
    const {fingerprint} = await storage();
    print(fingerprint(result.key));
}

function commandDelete(args) {
    const target = targetFor(args);
    try {
        Secret.password_clear_sync(schema(), target.attributes, null);
    } catch (error) {
        die(`не удалось удалить из связки: ${error.message}`, 3);
    }
    const name = target === PLATFORM_TARGET ? 'токен платформы' : 'ключ';
    print(`${name} удалён из связки; файл ~/.config/deepmon/${target.fileName} не тронут`);
}

const [command, ...args] = ARGV;

switch (command) {
case 'set':
    await commandSet(args);
    break;
case 'status':
    await commandStatus();
    break;
case 'fingerprint':
    await commandFingerprint(args);
    break;
case 'delete':
    commandDelete(args);
    break;
case '--help':
case '-h':
case undefined:
    print(USAGE);
    break;
default:
    die(`неизвестная команда: ${command}\n\n${USAGE}`, 2);
}
