#!/usr/bin/gjs -m
// deepmon-key — управление ключом DeepSeek API и токеном веб-сессии платформы.
// Сообщения берутся из каталога переводов расширения (po/ → locale/*.mo).
import GLib from 'gi://GLib';
import Gio from 'gi://Gio';
import Secret from 'gi://Secret';
import system from 'system';

const KEY_RE = /^sk-[A-Za-z0-9_-]{16,}$/;
const TOKEN_RE = /^[A-Za-z0-9._-]{16,}$/;
const KEY_TARGET = {kind: 'key', attributes: {application: 'deepmon', account: 'deepseek-api'},
    label: 'DeepSeek API key', fileName: 'key', pattern: KEY_RE};
const PLATFORM_TARGET = {kind: 'platform', attributes: {application: 'deepmon', account: 'deepseek-platform'},
    label: 'DeepSeek platform session token', fileName: 'platform-token', pattern: TOKEN_RE};

let cached = null;

function extensionDir() {
    const script = Gio.File.new_for_uri(import.meta.url).get_path();
    // Порядок: пользовательская копия, затем дерево исходников рядом со скриптом
    // (dev-запуск из репозитория), затем системная установка.
    const candidates = [
        GLib.build_filenamev([GLib.get_user_data_dir(), 'gnome-shell', 'extensions', 'deepmon@fstronin']),
        GLib.build_filenamev([GLib.path_get_dirname(GLib.path_get_dirname(script)), 'src', 'deepmon@fstronin']),
        '/usr/share/gnome-shell/extensions/deepmon@fstronin',
    ];
    for (const candidate of candidates) {
        if (Gio.File.new_for_path(GLib.build_filenamev([candidate, 'strings.js'])).query_exists(null))
            return candidate;
    }
    return null;
}

async function modules() {
    if (cached)
        return cached;
    const dir = extensionDir();
    if (!dir) {
        printerr('deepmon extension directory not found');
        system.exit(3);
    }
    const load = name => import(Gio.File.new_for_path(GLib.build_filenamev([dir, name])).get_uri());
    const [strings, keyReader, fileReader, keyringReader] = await Promise.all([
        load('strings.js'),
        load('storage/KeyReader.js'),
        load('storage/FileKeyReader.js'),
        load('storage/KeyringKeyReader.js'),
    ]);
    cached = {
        S: strings.S,
        fingerprint: keyReader.fingerprint,
        KeyReader: keyReader.KeyReader,
        FileKeyReader: fileReader.FileKeyReader,
        KeyringKeyReader: keyringReader.KeyringKeyReader,
    };
    return cached;
}

function die(message, code) {
    printerr(message);
    system.exit(code);
}

function schema() {
    return Secret.Schema.new('org.freedesktop.Secret.Generic', Secret.SchemaFlags.NONE, {
        application: Secret.SchemaAttributeType.STRING,
        account: Secret.SchemaAttributeType.STRING,
    });
}

function stdinIsTty() {
    try {
        const info = Gio.File.new_for_path('/proc/self/fd/0')
            .query_info('unix::mode', Gio.FileQueryInfoFlags.NONE, null);
        return (info.get_attribute_uint32('unix::mode') & 0o170000) === 0o020000;
    } catch (error) {
        return false;
    }
}

function stdinTerminal() {
    try {
        const info = Gio.File.new_for_path('/proc/self/fd/0')
            .query_info('standard::symlink-target', Gio.FileQueryInfoFlags.NONE, null);
        const target = info.get_symlink_target();
        if (!target)
            return null;
        return target.startsWith('/') ? target : `/dev/${target}`;
    } catch (error) {
        return null;
    }
}

// SubprocessLauncher отдаёт ребёнку stdin, а не терминал (ioctl на нём не работает),
// поэтому устройство передаётся явно через -F.
function stty(args) {
    const device = stdinTerminal();
    if (!device)
        return false;
    try {
        const launcher = new Gio.SubprocessLauncher({flags: Gio.SubprocessFlags.NONE});
        launcher.spawnv(['stty', '-F', device, ...args]).wait_check(null);
        return true;
    } catch (error) {
        printerr(`stty ${args.join(' ')}: ${error.message}`);
        return false;
    }
}

function readAll() {
    const [, bytes] = GLib.file_get_contents('/dev/stdin');
    return new TextDecoder().decode(bytes);
}

function readLineWithEchoOff(prompt, echoFailed) {
    const channel = GLib.IOChannel.unix_new(0);
    printerr(prompt);
    if (!stty(['-echo']))
        die(echoFailed, 3);
    try {
        const [status, line] = channel.read_line();
        return status === GLib.IOStatus.NORMAL ? line : '';
    } finally {
        stty(['echo']);
    }
}

function normalize(text) {
    let value = text.trim();
    if (value.startsWith('Bearer '))
        value = value.slice('Bearer '.length).trim();
    if (value.length >= 2 && ((value.startsWith('"') && value.endsWith('"')) ||
        (value.startsWith("'") && value.endsWith("'"))))
        value = value.slice(1, -1).trim();
    return value;
}

function targetFor(args) {
    return args.includes('--platform') ? PLATFORM_TARGET : KEY_TARGET;
}

function secretsOf(S, target) {
    const platform = target === PLATFORM_TARGET;
    return {
        name: platform ? S.cli.namePlatform : S.cli.nameKey,
        prompt: platform ? S.cli.promptPlatform : S.cli.promptKey,
        status: platform ? S.cli.statusPlatform : S.cli.statusApiKey,
        printed: value => (platform ? S.cli.tailPlatform : S.cli.tailKey).replace('{tail}', value.slice(-4)),
        invalid: platform ? S.cli.invalidToken : S.cli.invalidKey,
    };
}

async function resolveSecret(target) {
    const {KeyReader, FileKeyReader, KeyringKeyReader} = await modules();
    return new KeyReader({
        keyring: new KeyringKeyReader({attributes: target.attributes}),
        file: new FileKeyReader({
            path: GLib.build_filenamev([GLib.get_user_config_dir(), 'deepmon', target.fileName]),
            pattern: target.pattern,
        }),
        keyringTimeoutMs: 4000,
    }).readKey();
}

async function commandSet(args) {
    const {S, fingerprint} = await modules();
    const target = targetFor(args);
    const secrets = secretsOf(S, target);
    const useStdin = args.includes('--stdin');

    if (!useStdin && !stdinIsTty())
        die(S.cli.missingInput, 2);

    const raw = useStdin ? readAll() : readLineWithEchoOff(secrets.prompt, S.cli.echoFailed);
    const value = normalize(raw);
    if (!target.pattern.test(value))
        die(secrets.invalid, 2);

    let stored;
    try {
        stored = Secret.password_store_sync(schema(), target.attributes, Secret.COLLECTION_DEFAULT,
            target.label, value, null);
    } catch (error) {
        die(S.cli.storeFailed.replace('{detail}', error.message), 3);
    }
    if (!stored)
        die(S.cli.storeFailedShort, 3);

    print(S.cli.saved
        .replace('{secret}', secrets.printed(value))
        .replace('{hash}', fingerprint(value)));
}

async function commandStatus() {
    const {S, fingerprint} = await modules();
    for (const target of [KEY_TARGET, PLATFORM_TARGET]) {
        const secrets = secretsOf(S, target);
        const result = await resolveSecret(target);
        if (!result.ok) {
            print(`${secrets.status}: ${S.cli.none.replace('{code}', result.code)}`);
            continue;
        }
        const source = result.source === 'file'
            ? GLib.build_filenamev([GLib.get_user_config_dir(), 'deepmon', target.fileName])
            : 'keyring';
        print(`${secrets.status}: ${source}, ${secrets.printed(result.key)} · sha256 ${fingerprint(result.key)}`);
    }
}

async function commandFingerprint(args) {
    const {S, fingerprint} = await modules();
    const target = targetFor(args);
    const result = await resolveSecret(target);
    if (!result.ok)
        die(S.cli.none.replace('{code}', result.code), 3);
    print(fingerprint(result.key));
}

async function commandDelete(args) {
    const {S} = await modules();
    const target = targetFor(args);
    const secrets = secretsOf(S, target);
    try {
        Secret.password_clear_sync(schema(), target.attributes, null);
    } catch (error) {
        die(S.cli.storeFailed.replace('{detail}', error.message), 3);
    }
    print(S.cli.deleted
        .replace('{name}', secrets.name)
        .replace('{path}', S.cli.deletedPath.replace('{file}', target.fileName)));
}

const [command, ...args] = ARGV;

switch (command) {
case 'set':
    await commandSet(args);
    break;
case 'status':
    await commandStatus();
    break;
case 'fingerprint':
    await commandFingerprint(args);
    break;
case 'delete':
    await commandDelete(args);
    break;
case '--help':
case '-h':
case undefined: {
    const {S} = await modules();
    print(S.cli.usage);
    break;
}
default: {
    const {S} = await modules();
    die(S.cli.unknownCommand.replace('{command}', command), 2);
}
}
