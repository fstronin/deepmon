<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.deepmon.panel-mode">
    <value nick="both" value="0"/>
    <value nick="balance" value="1"/>
    <value nick="spend" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.deepmon"
          path="/org/gnome/shell/extensions/deepmon/">
    <key name="refresh-minutes" type="u">
      <default>15</default>
      <range min="1" max="120"/>
      <summary>Интервал опроса баланса, минуты</summary>
    </key>
    <key name="daily-limit" type="d">
      <default>1.0</default>
      <range min="0" max="10000"/>
      <summary>Дневной порог расходов в основной валюте</summary>
    </key>
    <key name="daily-limit-enabled" type="b">
      <default>true</default>
      <summary>Уведомлять о превышении дневного порога</summary>
    </key>
    <key name="currency" type="s">
      <default>''</default>
      <summary>Валюта учёта: пусто — авто (первая в ответе API)</summary>
    </key>
    <key name="panel-mode" enum="org.gnome.shell.extensions.deepmon.panel-mode">
      <default>'both'</default>
      <summary>Что показывать в панели</summary>
    </key>
    <key name="chart-days" type="u">
      <default>14</default>
      <range min="7" max="90"/>
      <summary>Длина графика расходов, дни</summary>
    </key>
    <key name="api-base-url" type="s">
      <default>'https://api.deepseek.com'</default>
      <summary>База API DeepSeek</summary>
    </key>
    <key name="platform-base-url" type="s">
      <default>'https://platform.deepseek.com'</default>
      <summary>База приватных эндпоинтов платформы (дневные расходы)</summary>
    </key>
    <key name="key-file" type="s">
      <default>''</default>
      <summary>Путь к резервному файлу ключа; пусто — ~/.config/deepmon/key</summary>
    </key>
  </schema>
</schemalist>
